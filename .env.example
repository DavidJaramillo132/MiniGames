# Replace every value before deployment. Do not commit the copied .env file.
POSTGRES_DB=PlayHub
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password
JWT_KEY=replace-with-a-long-random-jwt-signing-key-at-least-32-characters
JWT_ISSUER=replace-with-jwt-issuer
JWT_AUDIENCE=replace-with-jwt-audience
JWT_EXPIRES_IN_MINUTES=replace-with-token-lifetime-in-minutes
